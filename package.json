{
    "name": "@type32/obsidian-bases-parser",
    "version": "0.3.4",
    "description": "A complete TypeScript implementation for Obsidian Bases (.base files) including schema definitions, lexer, parser, evaluator, and reactive query system with Vue integration.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "echo \"Error: no test specified\" && exit 1",
        "release:minor": "bun run build && bun pm version minor && bun publish",
        "release:patch": "bun run build && bun pm version patch && bun publish"
    },
    "keywords": [
        "obsidian",
        "obsidian-bases",
        "bases",
        "database",
        "query",
        "filter",
        "formula",
        "yaml",
        "typescript",
        "vue",
        "reactive",
        "parser",
        "lexer",
        "ast"
    ],
    "author": "Type-32",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.3",
        "vue": "^3.5.45"
    },
    "dependencies": {
        "js-yaml": "^5.5.0"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    }
}
