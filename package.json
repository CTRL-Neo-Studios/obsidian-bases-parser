{
    "name": "@type32/obsidian-bases-parser",
    "version": "0.4.0",
    "description": "Obsidian Bases (.base files) in plain TypeScript: the expression language, functions, queries, summaries and Obsidian-compatible reading and writing of .base files.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md",
        "llms.txt",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "eslint .",
        "test": "vitest run",
        "test:types": "tsc --noEmit",
        "release:minor": "bun pm version minor && bun publish",
        "release:patch": "bun pm version patch && bun publish",
        "prepack": "bun run build"
    },
    "keywords": [
        "obsidian",
        "obsidian-bases",
        "bases",
        "database",
        "query",
        "filter",
        "formula",
        "yaml",
        "typescript",
        "parser",
        "lexer",
        "ast"
    ],
    "author": "Type-32",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "dayjs": "^1.11.23",
        "js-yaml": "^5.5.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Type-32/obsidian-bases-parser.git"
    },
    "homepage": "https://github.com/Type-32/obsidian-bases-parser#readme",
    "bugs": {
        "url": "https://github.com/Type-32/obsidian-bases-parser/issues"
    }
}
